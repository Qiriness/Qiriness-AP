{%- liquid
  assign product_handle = ''
  if product
    assign product_handle = product.handle
  endif
  assign collection_handle = ''
  if collection
    assign collection_handle = collection.handle
  endif
  assign endpoint = block.settings.proxy_path | strip | append: '/chat'
  assign banner_text = block.settings.banner_text | strip
  if banner_text == blank
    assign banner_text = 'banner.text' | t
  endif
  assign greeting = block.settings.greeting | strip
  if greeting == blank
    assign greeting = 'advisor.greeting' | t: shop: shop.name
  endif
  assign logo_url = ''
  if block.settings.logo != blank
    assign logo_url = block.settings.logo | image_url: width: 320
  elsif shop.brand.square_logo != blank
    assign logo_url = shop.brand.square_logo | image_url: width: 320
  elsif shop.brand.logo != blank
    assign logo_url = shop.brand.logo | image_url: width: 320
  endif
  assign banner_button = block.settings.banner_button | strip
  if banner_button == blank
    assign banner_button = 'banner.button' | t
  endif
-%}
<div
  id="storefront-advisor"
  class="sa-root sa-root--{{ block.settings.position }} notranslate"
  translate="no"
  data-wg-notranslate
  style="--sa-accent: {{ block.settings.accent_color }}; --sa-bottom: {{ block.settings.launcher_bottom }}px;{% if block.settings.font_heading != blank %} --sa-heading: '{{ block.settings.font_heading | strip | escape }}', Georgia, serif;{% endif %}{% if block.settings.font_body != blank %} --sa-body: '{{ block.settings.font_body | strip | escape }}', 'Helvetica Neue', Arial, sans-serif;{% endif %}"
></div>
<script type="application/json" id="storefront-advisor-config">
  {
    "endpoint": {{ endpoint | json }},
    "panelScript": {{ 'advisor-panel.js' | asset_url | json }},
    "cartScript": {{ 'advisor-cart.js' | asset_url | json }},
    "stringsScript": {{ 'advisor-strings.js' | asset_url | json }},
    "shopName": {{ shop.name | json }},
    "logo": {{ logo_url | json }},
    "custom": {
      "greeting": {% if block.settings.greeting != blank %}true{% else %}false{% endif %},
      "bannerText": {% if block.settings.banner_text != blank %}true{% else %}false{% endif %},
      "bannerButton": {% if block.settings.banner_button != blank %}true{% else %}false{% endif %}
    },
    "fontsUrl": {{ block.settings.fonts_url | strip | json }},
    "termsPath": {{ block.settings.terms_path | strip | json }},
    "context": {
      "pageType": {{ request.page_type | json }},
      "productHandle": {{ product_handle | json }},
      "collectionHandle": {{ collection_handle | json }},
      "locale": {{ request.locale.iso_code | json }},
      "country": {{ localization.country.iso_code | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "market": {{ localization.market.id | prepend: 'gid://shopify/Market/' | json }},
      "variantId": {{ product.selected_or_first_available_variant.id | prepend: 'gid://shopify/ProductVariant/' | json }},
      "loggedIn": {% if customer %}true{% else %}false{% endif %}
    },
    "banner": {
      "enabled": {{ block.settings.banner_enabled | json }},
      "text": {{ banner_text | json }},
      "button": {{ banner_button | json }},
      "close": {{ 'banner.close' | t | json }},
      "action": {{ 'actions.build_routine' | t | json }},
      "hours": {{ block.settings.banner_hours | json }},
      "delay": {{ block.settings.banner_delay | json }},
      "lift": {{ block.settings.banner_lift | strip | json }}
    },
    "viewer": {% if customer %}{{ customer.id | append: '' | json }}{% else %}""{% endif %},
    "quickActions": [
      {%- assign first = true -%}
      {%- if block.settings.action_build_routine -%}{"id": "build_routine", "label": {{ 'actions.build_routine' | t | json }}}{%- assign first = false -%}{%- endif -%}
      {%- if block.settings.action_find_product -%}{%- unless first -%},{%- endunless -%}{"id": "find_product", "label": {{ 'actions.find_product' | t | json }}}{%- assign first = false -%}{%- endif -%}
      {%- if block.settings.action_delivery -%}{%- unless first -%},{%- endunless -%}{"id": "delivery", "label": {{ 'actions.delivery' | t | json }}}{%- assign first = false -%}{%- endif -%}
      {%- if block.settings.action_returns -%}{%- unless first -%},{%- endunless -%}{"id": "returns", "label": {{ 'actions.returns' | t | json }}}{%- assign first = false -%}{%- endif -%}
      {%- if block.settings.action_compare -%}{%- unless first -%},{%- endunless -%}{"id": "compare", "label": {{ 'actions.compare' | t | json }}}{%- assign first = false -%}{%- endif -%}
      {%- if block.settings.action_offers -%}{%- unless first -%},{%- endunless -%}{"id": "offers", "label": {{ 'actions.offers' | t | json }}}{%- endif -%}
    ],
    "strings": {
      "title": {{ 'advisor.title' | t: shop: shop.name | json }},
      "routineNote": {{ 'actions.build_routine_note' | t | json }},
      "launcher": {{ 'advisor.launcher' | t | json }},
      "open": {{ 'advisor.open' | t | json }},
      "close": {{ 'advisor.close' | t | json }},
      "newChat": {{ 'advisor.new_chat' | t | json }},
      "greeting": {{ greeting | json }},
      "placeholder": {{ 'advisor.placeholder' | t | json }},
      "inputLabel": {{ 'advisor.input_label' | t | json }},
      "send": {{ 'advisor.send' | t | json }},
      "typing": {{ 'advisor.typing' | t | json }},
      "waitLooking": {{ 'advisor.wait_looking' | t | json }},
      "waitOrder": {{ 'advisor.wait_order' | t | json }},
      "waitLonger": {{ 'advisor.wait_longer' | t | json }},
      "error": {{ 'advisor.error' | t | json }},
      "retry": {{ 'advisor.retry' | t | json }},
      "errorSessionLimit": {{ 'advisor.error_session_limit' | t | json }},
      "errorDailyLimit": {{ 'advisor.error_daily_limit' | t | json }},
      "discover": {{ 'advisor.discover' | t | json }},
      "addToCart": {{ 'advisor.add_to_cart' | t | json }},
      "added": {{ 'advisor.added_to_cart' | t | json }},
      "addFailed": {{ 'advisor.add_failed' | t | json }},
      "addRoutine": {{ 'advisor.add_routine' | t | json }},
      "addRoutineDiscount": {{ 'advisor.add_routine_discount' | t | json }},
      "chooseSize": {{ 'advisor.choose_size' | t | json }},
      "cartAdded": {{ 'advisor.cart_added' | t | json }},
      "cartFailed": {{ 'advisor.cart_failed' | t | json }},
      "contactForm": {{ 'advisor.contact_form' | t | json }},
      "disclaimer": {{ 'advisor.disclaimer' | t | json }},
      "terms": {{ 'advisor.terms' | t | json }},
      "quickActionsLabel": {{ 'advisor.quick_actions_label' | t | json }},
      "productsLabel": {{ 'advisor.products_label' | t | json }},
      "you": {{ 'advisor.you' | t | json }},
      "advisor": {{ 'advisor.advisor' | t | json }},
      "feedbackAsk": {{ 'advisor.feedback_ask' | t | json }},
      "feedbackUp": {{ 'advisor.feedback_up' | t | json }},
      "feedbackDown": {{ 'advisor.feedback_down' | t | json }},
      "feedbackThanks": {{ 'advisor.feedback_thanks' | t | json }},
      "viewing": {{ 'advisor.viewing' | t | json }},
      "routine": {
        "expand": {{ 'routine.expand' | t | json }},
        "collapse": {{ 'routine.collapse' | t | json }},
        "title": {{ 'routine.title' | t | json }},
        "hint": {{ 'routine.hint' | t | json }},
        "morning_eyebrow": {{ 'routine.morning_eyebrow' | t | json }},
        "morning": {{ 'routine.morning' | t | json }},
        "evening_eyebrow": {{ 'routine.evening_eyebrow' | t | json }},
        "evening": {{ 'routine.evening' | t | json }},
        "stage_cleanse": {{ 'routine.stage_cleanse' | t | json }},
        "stage_prepare": {{ 'routine.stage_prepare' | t | json }},
        "stage_activate": {{ 'routine.stage_activate' | t | json }},
        "stage_optimise": {{ 'routine.stage_optimise' | t | json }},
        "stage_regenerate": {{ 'routine.stage_regenerate' | t | json }},
        "why": {{ 'routine.why' | t | json }},
        "ingredients": {{ 'routine.ingredients' | t | json }},
        "benefits": {{ 'routine.benefits' | t | json }},
        "usage": {{ 'routine.usage' | t | json }},
        "included": {{ 'routine.included' | t | json }},
        "reviews": {{ 'routine.reviews' | t | json }},
        "owned_morning": {{ 'routine.owned_morning' | t | json }},
        "owned_evening": {{ 'routine.owned_evening' | t | json }},
        "choose_size": {{ 'routine.choose_size' | t | json }},
        "unavailable": {{ 'routine.unavailable' | t | json }},
        "complete": {{ 'routine.complete' | t | json }},
        "remove": {{ 'routine.remove' | t | json }},
        "complete_note": {{ 'routine.complete_note' | t | json }},
        "complete_none": {{ 'routine.complete_none' | t | json }},
        "total": {{ 'routine.total' | t | json }},
        "saving": {{ 'routine.saving' | t | json }},
        "min_note": {{ 'routine.min_note' | t | json }},
        "banner_eyebrow": {{ 'routine.banner_eyebrow' | t | json }},
        "banner_title": {{ 'routine.banner_title' | t | json }},
        "banner_text": {{ 'routine.banner_text' | t | json }},
        "banner_add": {{ 'routine.banner_add' | t | json }},
        "banner_added": {{ 'routine.banner_added' | t | json }},
        "add": {{ 'routine.add' | t | json }},
        "added": {{ 'routine.added' | t | json }},
        "add_again": {{ 'routine.add_again' | t | json }},
        "already_in_cart": {{ 'routine.already_in_cart' | t | json }},
        "headline": {{ 'routine.headline' | t | json }},
        "glance": {{ 'routine.glance' | t | json }},
        "ritual_title": {{ 'routine.ritual_title' | t | json }},
        "ritual_sub": {{ 'routine.ritual_sub' | t | json }},
        "show_steps": {{ 'routine.show_steps' | t | json }},
        "hide_steps": {{ 'routine.hide_steps' | t | json }},
        "morning_short": {{ 'routine.morning_short' | t | json }},
        "evening_short": {{ 'routine.evening_short' | t | json }},
        "optional": {{ 'routine.optional' | t | json }},
        "owned_short_morning": {{ 'routine.owned_short_morning' | t | json }},
        "owned_short_evening": {{ 'routine.owned_short_evening' | t | json }},
        "selection": {{ 'routine.selection' | t | json }},
        "essentials": {{ 'routine.essentials' | t | json }},
        "selected_count": {{ 'routine.selected_count' | t | json }},
        "more_eyebrow": {{ 'routine.more_eyebrow' | t | json }},
        "more_title": {{ 'routine.more_title' | t | json }},
        "add_one": {{ 'routine.add_one' | t | json }},
        "details_hide": {{ 'routine.details_hide' | t | json }},
        "with_morning": {{ 'routine.with_morning' | t | json }},
        "with_evening": {{ 'routine.with_evening' | t | json }},
        "discount_applied": {{ 'routine.discount_applied' | t | json }}
      }
    }
  }
</script>

{% schema %}
{
  "name": "Beauty advisor",
  "target": "body",
  "javascript": "advisor.js",
  "stylesheet": "advisor.css",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "App proxy path",
      "info": "The app proxy prefix and subpath, as shown in Settings > Apps for this app.",
      "default": "/apps/storefront-advisor"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Launcher position",
      "options": [
        { "value": "right", "label": "Bottom right" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "right"
    },
    { "type": "range", "id": "launcher_bottom", "label": "Chat button distance from the bottom", "info": "0 sits it on the bottom edge. Above the routine banner while that shows.", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#23201c"
    },
    { "type": "image_picker", "id": "logo", "label": "Advisor picture", "info": "Shown in a circle at the top of the chat. Empty: the shop logo from Settings > Brand." },
    { "type": "text", "id": "font_heading", "label": "Heading font", "info": "Titles and product names. Must be in the fonts stylesheet below.", "default": "Cormorant Garamond" },
    { "type": "text", "id": "font_body", "label": "Body font", "info": "Messages, buttons and labels.", "default": "DM Sans" },
    { "type": "text", "id": "fonts_url", "label": "Fonts stylesheet", "info": "Loaded only once the advisor shows. Empty: the fonts must already be on the page.", "default": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=DM+Sans:wght@400;500;600&display=swap" },
    { "type": "header", "content": "Quick actions" },
    { "type": "paragraph", "content": "Listed under the first message, in this order." },
    { "type": "checkbox", "id": "action_build_routine", "label": "Build my routine", "default": true },
    { "type": "checkbox", "id": "action_find_product", "label": "Find my skincare", "default": true },
    { "type": "checkbox", "id": "action_delivery", "label": "Delivery times", "default": true },
    { "type": "checkbox", "id": "action_returns", "label": "Return policy", "default": true },
    { "type": "checkbox", "id": "action_compare", "label": "Compare products", "default": false },
    { "type": "checkbox", "id": "action_offers", "label": "Current offers", "default": false },
    { "type": "text", "id": "terms_path", "label": "Terms page", "info": "The page « See T&Cs » under the message bar opens, a path on this shop. Leave empty to hide the link.", "default": "/pages/conditions-generales-de-ventes" },
    { "type": "header", "content": "Routine banner" },
    { "type": "checkbox", "id": "banner_enabled", "label": "Show the routine banner", "info": "A bar across the bottom of the screen; its button opens the advisor and starts the routine builder.", "default": true },
    { "type": "textarea", "id": "greeting", "label": "Greeting", "info": "The advisor's first message. Leave empty for the default, in the visitor's language." },
    { "type": "text", "id": "banner_text", "label": "Banner text", "info": "Leave empty for the default text, in the visitor's language." },
    { "type": "text", "id": "banner_button", "label": "Banner button", "info": "Leave empty for the default label, in the visitor's language." },
    { "type": "range", "id": "banner_delay", "label": "Show the chat button and banner after", "info": "Seconds into the visit, counted across pages: leaves time for the cookie banner. The chat button shows at once if the chat was left open.", "min": 0, "max": 120, "step": 5, "unit": "s", "default": 15 },
    { "type": "range", "id": "banner_hours", "label": "Hidden after closing for", "min": 1, "max": 72, "step": 1, "unit": "h", "default": 4 },
    { "type": "text", "id": "banner_lift", "label": "Lift above the banner", "info": "CSS selectors of other widgets pinned to the bottom of the screen, comma-separated. Default: Klaviyo's sign-up teaser. Empty: nothing is moved.", "default": "[class*=\"kl-teaser\"]" }
  ]
}
{% endschema %}
