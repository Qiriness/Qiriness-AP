{
  "version": 1,
  "brand": "Qiriness",
  "_about": "Qiriness advisory routine playbooks (authored by Qiriness, 2026-10-07) plus the mappings that make them executable against the catalogue. Products are NEVER named by id: families, slots and signals resolve through collections, tags, care types and name words, checked by `npm run advisor:load -- --dry-run`. Product facts and claims come from product data only, never from this file. Keys marked `_added` are interpretations needed to execute the playbooks, to be confirmed by Qiriness.",

  "principles": [
    "Primary concern drives playbook selection.",
    "Skin type mainly determines texture / variant.",
    "Sensitivity can override normal recommendations.",
    "Age is a weak modifier only.",
    "Current routine should prevent unnecessary duplicate recommendations.",
    "Stock remains a hard constraint.",
    "Merchandising priority is applied AFTER suitability."
  ],

  "selection_priority": ["body_area", "primary_concern", "skin_type_and_behaviour", "sensitivity", "current_routine", "requested_product_or_routine_scope", "secondary_concerns", "sex_target", "age"],
  "ambiguity_rule": [
    "if two playbooks remain genuinely plausible, ask one conversational question that best distinguishes them",
    "do not simply choose based on age"
  ],
  "routine_completion": {
    "logic": [
      "determine applicable playbook",
      "determine desired routine scope",
      "compare required slots against customer's existing routine",
      "recommend missing/high-value slots only",
      "don't replace suitable existing products unless the customer wants to"
    ]
  },

