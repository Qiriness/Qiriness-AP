  "sizes": {
    "essential": {
      "rule": "the first daily required steps of the foundation",
      "steps": [
        2,
        3
      ],
      "default": true
    },
    "complete": {
      "rule": "every daily step that has a suitable product, plus the relevant modules",
      "steps": [
        4,
        5
      ]
    },
    "spa": {
      "rule": "complete plus the occasional steps (exfoliant, mask, patches); chosen by the customer, never added automatically"
    },
    "one_product": {
      "rule": "the first useful step the customer does not already cover; only on request",
      "steps": [
        1,
        1
      ]
    },
    "never_pad": "a step is filled only when a suitable product exists; an empty step is said, never filled with a poor match",
    "owned": "a product type the customer already has or uses counts toward the size and is not doubled — unless their concern points to a specific product for that step (« j'ai un sérum hydratant mais j'ai des taches »: the anti-spot serum is still proposed, with why)"
