# Shopify
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_CLIENT_ID=your_client_id
SHOPIFY_CLIENT_SECRET=your_client_secret

# Optional for Dev Dashboard apps: if blank, scripts request a 24-hour token
# using SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret
SHOPIFY_API_VERSION=unstable_or_supported_version
# Optional comma-separated Shopify metaobject definition types. If blank,
# the product sync targets Ingredients List and Product FAQ definitions by name.
SHOPIFY_METAOBJECT_TYPES=

# Nightly Shopify -> Supabase sync schedule for the deployment scheduler.
SYNC_CRON=0 2 * * *
SYNC_TIMEZONE=Europe/London

# Local compliance webhook harness inputs. Production runtimes should pass
# real HTTP headers directly to the webhook handler.
SHOPIFY_WEBHOOK_TOPIC=
SHOPIFY_WEBHOOK_SHOP_DOMAIN=
SHOPIFY_WEBHOOK_ID=
SHOPIFY_WEBHOOK_HMAC_SHA256=
SHOPIFY_WEBHOOK_API_VERSION=
SHOPIFY_WEBHOOK_TRIGGERED_AT=
SHOPIFY_WEBHOOK_EVENT_ID=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Direct Postgres connection, used ONLY by scripts/apply-supabase-migration.mjs.
# Use the SESSION POOLER string from the Supabase dashboard (Project Settings ->
# Database -> Connection string -> Session pooler), NOT the direct
# db.<ref>.supabase.co one: Supabase made direct connections IPv6-only, so on an
# IPv4-only network the direct host resolves AAAA with no A record and node
# fails with `getaddrinfo ENOTFOUND`. The pooler is IPv4 and works either way.
# Note the username carries the project ref: postgres.<project-ref>
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres

# OPENAI
OPENAI_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=info

#Microsoft
MS_GRAPH_TENANT_ID=…
MS_GRAPH_CLIENT_ID=…
MS_GRAPH_CLIENT_SECRET=…
SUPPORT_MAILBOX=onouailhetas@lap-groupe.com

# Senders that are ours or operational rather than customers. The support
# mailbox domain is treated as internal automatically; this is for what it
# cannot imply — a second corporate domain, or a logistics provider whose mail
# is ops traffic. Reporting over the ticket corpus (`npm run cluster:tickets`)
# excludes these, so topic demand reflects customers only. Comma-separated.
INTERNAL_EMAIL_DOMAINS=

# Which sender_directory label counts as which actor on a case (customer,
# support, colleague, partner). Per business: one company's 3PL is part of the
# team, another's a supplier. Unset keeps the default map below; a label left
# out keeps its default.
# AGENT_ACTOR_BY_LABEL=internal:colleague,contractor:colleague,logistics:partner,courier:partner,retailer:customer
# Ticket status from who acts next (stage 5c). `off` leaves statuses to the
# investigation verdict; each actor lists accepted statuses, the first is where
# a ticket moves. `nobody:open` keeps finished cases in the queue for a person.
# AGENT_CASE_STATUS_BY_NEXT_ACTOR=customer:awaiting_customer,support:open|awaiting_human,colleague:awaiting_human,partner:awaiting_human,nobody:resolved
# Snooze (off unless true): the fold snoozes a case our SENT reply left waiting on
# the customer / a colleague / an operations partner, until the shop's delay
# (customer_reply_wait_days, colleague_/partner_check_overdue_days). Needs the
# full pipeline: the Case Manager reads our reply. New mail and deadlines wake
# tickets whatever this says. Try `npm run snooze -- --dry-run` first.
# AGENT_AUTO_SNOOZE=false
# Case linking (the `link` pass): ambiguous threads go to a small model only when
# this is true. Off, they open their own case and their candidates are logged.
# Run `npm run cases:replay` (agent/) and read every link first. DECISIONS § Cases.
# CASE_LINKER_ENABLED=false
# AGENT_CASE_LINK_MODEL=gpt-4o-mini
# Drafting in the worker (stage 6), off unless true. Run
# `npm run draft -- --dry-run --gates=poll` first: counts and cost, no model call.
# DRAFT_IN_POLL=false
# DRAFT_POLL_LIMIT=10
# Sending replies (the outbound worker). Off unless true: with it off, Approve
# in /tickets records a decision and sends nothing. Needs Graph Mail.ReadWrite
# and Mail.Send. Read by both the dashboard and the worker.
# OUTBOUND_SEND_ENABLED=false
# For testing the send path: every check runs and the threaded reply draft is
# created in the support mailbox's Drafts folder, but the worker never sends
# it. Send it from Outlook yourself; Sent Items confirms it. Read by both.
# OUTBOUND_STOP_BEFORE_SEND=false
# Graph change notifications: the public HTTPS URL of /api/webhooks/graph.
# Unset, no subscription is created and the timed poll does everything.
# MAIL_WEBHOOK_URL=
# JOB_CHECK_INTERVAL_MS=5000
# MAIL_JOB_MAX_ATTEMPTS=5
# Social and paid media (Insights -> Social media). This APP's credentials; each
# shop's token is stored in Supabase Vault when someone clicks Connect. Set on
# Vercel (callback), Render (worker sync) and GitHub Actions (nightly). Unset,
# that provider shows Connect disabled with the missing names. README ->
# Social connectors.
# META_APP_ID=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v23.0
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Optional and ignored by Google since developer tokens were sunset (2026-09-09);
# API access now belongs to the Cloud project of the OAuth client above.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v21
# 32+ random characters; signs the OAuth state (dashboard only).
# SOCIAL_OAUTH_STATE_SECRET=
# Only if the dashboard is reached through another host than the registered redirect.
# PUBLIC_APP_URL=https://qiriness-ap.vercel.app
# Storefront advisor (docs/storefront-chatbot.md). DEV STORE ONLY. The client
# secret of the SEPARATE advisor app in storefront-app/ (not SHOPIFY_CLIENT_SECRET):
# it verifies the app proxy signature. Unset, /api/storefront/chat answers 404.
# The allow-list is the shops the route serves; empty serves none. Never list
# the production store here.
# STOREFRONT_APP_CLIENT_SECRET=
# STOREFRONT_CHAT_ALLOWED_SHOPS=your-dev-store.myshopify.com
# STOREFRONT_CHAT_SESSION_TURN_CAP=40
# STOREFRONT_CHAT_SHOP_DAILY_CAP=500
# STOREFRONT_CHAT_RETENTION_DAYS=30
# Who answers: mock (default, Phase 1 replies) or llm (OPENAI_API_KEY, no tools).
# Opt-in: the production dashboard carries this route too.
# STOREFRONT_CHAT_AGENT=mock
# STOREFRONT_CHAT_MODEL=gpt-6-luna
# STOREFRONT_CHAT_TIMEOUT_MS=12000
# Phase 3 product tools: on unless off. Prices are formatted in this currency.
# STOREFRONT_CHAT_TOOLS=on
# STOREFRONT_CHAT_CURRENCY=EUR
# DEV ONLY. The dev store lacks the catalogue's products, so « Découvrir » links
# to the store that has them (new tab). Unset in production: links stay relative.
# STOREFRONT_CHAT_PRODUCT_BASE_URL=https://qiriness.com
# DEV ONLY (removed with the dev setup — docs/storefront-chatbot.md § Dev store).
# The client id of the advisor app (storefront-app/), used with its secret by
# `npm run dev-store:sync` to copy the dev store into Supabase as a development
# shop. STOREFRONT_DEV_STORE_DOMAIN defaults to the first allowed shop.
# STOREFRONT_APP_CLIENT_ID=
# STOREFRONT_DEV_STORE_DOMAIN=
# Point the advisor's catalogue at that synced dev shop (unset in production):
# STOREFRONT_CHAT_CATALOGUE_SHOP_DOMAIN=your-dev-store.myshopify.com
# Monthly sales report, mailed by the worker on the 1st. Off unless the URL
# (worker) and the secret (worker AND dashboard, 32+ chars) are both set.
# Recipients: active dashboard accounts with SALES_REPORT_ROLES, plus extras.
# SALES_REPORT_URL=https://<dashboard host>/api/reports/sales
# SALES_REPORT_SECRET=
# SALES_REPORT_ROLES=management
# SALES_REPORT_EXTRA_RECIPIENTS=
# SALES_REPORT_SEND_HOUR=8
