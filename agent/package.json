{
  "name": "qiriness-agent-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Support-agent worker: Microsoft Graph email ingestion + AI ticket workflow. See ../AGENT_INTEGRATION_PLAN.md.",
  "scripts": {
    "start": "node src/index.mjs",
    "ingest:once": "node src/index.mjs --once",
    "ingest:reset": "node src/tools/reset-cursor.mjs",
    "blocklist:add": "node src/tools/add-blocklist.mjs",
    "eval:categorise": "node eval/run-categorisation-eval.mjs",
    "review:sample": "node eval/sample-mailbox.mjs",
    "review:compare": "node eval/compare-review-labels.mjs",
    "test": "node --test \"src/**/*.test.mjs\" \"eval/**/*.test.mjs\"",
    "forward:once": "node src/tools/run-forwarding.mjs",
    "forward:dry-run": "node src/tools/run-forwarding.mjs --dry-run",
    "orders:resolve": "node src/tools/run-order-resolution.mjs",
    "orders:resolve:dry-run": "node src/tools/run-order-resolution.mjs --dry-run",
    "context:build": "node src/tools/run-order-context.mjs",
    "context:build:dry-run": "node src/tools/run-order-context.mjs --dry-run",
    "customer:lookup": "node src/tools/run-customer-lookup.mjs",
    "investigate": "node src/tools/run-investigation.mjs",
    "investigate:dry-run": "node src/tools/run-investigation.mjs --dry-run",
    "customers:resolve": "node src/tools/run-customer-resolution.mjs",
    "customers:resolve:dry-run": "node src/tools/run-customer-resolution.mjs --dry-run",
    "tickets:autoclose": "node src/tools/run-auto-close.mjs",
    "tickets:autoclose:dry-run": "node src/tools/run-auto-close.mjs --dry-run",
    "spam:backfill": "node src/tools/run-spam-body-backfill.mjs",
    "spam:backfill:dry-run": "node src/tools/run-spam-body-backfill.mjs --dry-run",
    "attachments:backfill": "node src/tools/run-attachment-backfill.mjs",
    "attachments:backfill:dry-run": "node src/tools/run-attachment-backfill.mjs --dry-run",
    "eval:retrieval": "node eval/run-retrieval-eval.mjs",
    "eval:diagnose": "node eval/diagnose-retrieval.mjs",
    "eval:exemplars": "node eval/diagnose-exemplars.mjs",
    "eval:exemplar-needs": "node eval/compare-exemplar-needs.mjs",
    "eval:audit-phrasings": "node eval/audit-phrasings.mjs",
    "eval:knowledge-gaps": "node eval/knowledge-gaps.mjs",
    "draft": "node src/tools/run-drafting.mjs",
    "draft:dry-run": "node src/tools/run-drafting.mjs --dry-run",
    "repair:contact-form": "node src/tools/run-contact-form-repair.mjs",
    "repair:contact-form:dry-run": "node src/tools/run-contact-form-repair.mjs --dry-run",
    "related:backfill": "node src/tools/run-related-backfill.mjs",
    "related:backfill:dry-run": "node src/tools/run-related-backfill.mjs --dry-run",
    "duplicate:backfill": "node src/tools/run-duplicate-backfill.mjs",
    "duplicate:backfill:dry-run": "node src/tools/run-duplicate-backfill.mjs --dry-run",
    "sender-label:backfill": "node src/tools/run-sender-label-backfill.mjs",
    "sender-label:backfill:dry-run": "node src/tools/run-sender-label-backfill.mjs --dry-run",
    "requester:repair": "node src/tools/run-requester-repair.mjs",
    "requester:repair:dry-run": "node src/tools/run-requester-repair.mjs --dry-run"
  }
}
