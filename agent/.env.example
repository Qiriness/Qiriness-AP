# Agent worker environment.
#
# The worker reads the REPO-ROOT .env.local (same file the sync scripts use), so
# add the variables below to ../.env.local rather than creating a separate file.
# Never commit real secrets.

# --- Reused from the existing sync setup (already present in ../.env.local) ---
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SHOPIFY_STORE_DOMAIN=

# --- Microsoft Graph (mailbox ingestion) — add these ---
# Azure app registration (client credentials flow) with Mail.Read / Mail.Send
# application permissions granted admin consent for the tenant.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox to ingest, as a Graph user id or userPrincipalName.
SUPPORT_MAILBOX=onouailhetas@lap-groupe.com

# --- Worker tunables (optional; defaults shown) ---
# Delta-poll interval in milliseconds.
INGEST_POLL_INTERVAL_MS=60000
# Draft-only mode: nothing is auto-sent while true (Phase 1/early rollout).
DRAFT_ONLY=true
