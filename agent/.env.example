# Agent worker environment.
#
# The worker reads the REPO-ROOT .env.local (same file the sync scripts use), so
# add the variables below to ../.env.local rather than creating a separate file.
# Never commit real secrets.

# --- Reused from the existing sync setup (already present in ../.env.local) ---
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# SHOPIFY_STORE_DOMAIN=

# --- Microsoft Graph (mailbox ingestion) — add these ---
# Azure app registration (client credentials flow) with Mail.Read / Mail.Send
# application permissions granted admin consent for the tenant.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The mailbox to ingest, as a Graph user id or userPrincipalName.
SUPPORT_MAILBOX=onouailhetas@lap-groupe.com

# --- OpenAI (LLM stages) ---
# Shared with the knowledge embeddings. Without it the worker still ingests mail;
# it just skips the LLM spam pass and leaves tickets uncategorised.
# OPENAI_API_KEY=

# --- Worker tunables (optional; defaults shown) ---
# Cheap-tier models for the two classification stages.
AGENT_TRIAGE_MODEL=gpt-4o-mini
AGENT_CATEGORISER_MODEL=gpt-4o-mini
# Delta-poll interval in milliseconds.
INGEST_POLL_INTERVAL_MS=60000
# Draft-only mode: nothing is auto-sent while true (Phase 1/early rollout).
DRAFT_ONLY=true

# Which sender_directory label counts as which actor on a case (customer,
# support, colleague, partner). Per business: one company's 3PL is part of the
# team, another's a supplier. Unset keeps the default map below; a label left
# out keeps its default.
# AGENT_ACTOR_BY_LABEL=internal:colleague,contractor:colleague,logistics:partner,courier:partner,retailer:customer
# Ticket status from who acts next (stage 5c). `off` leaves statuses to the
# investigation verdict; each actor lists accepted statuses, the first is where
# a ticket moves. `nobody:open` keeps finished cases in the queue for a person.
# AGENT_CASE_STATUS_BY_NEXT_ACTOR=customer:awaiting_customer,support:open|awaiting_human,colleague:awaiting_human,partner:awaiting_human,nobody:resolved
# Drafting in the worker (stage 6), off unless true. Run
# `npm run draft -- --dry-run --gates=poll` first: counts and cost, no model call.
# DRAFT_IN_POLL=false
# DRAFT_POLL_LIMIT=10
